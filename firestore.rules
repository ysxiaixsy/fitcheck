rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validClothing() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'colorName', 'category', 'formality', 'occasionIds',
          'tracksLaundry', 'washAfterWears', 'wearsSinceWash', 'lastWorn', 'photoUrl'])
        && d.keys().hasOnly(['name', 'colorName', 'category', 'formality', 'occasionIds',
          'tracksLaundry', 'washAfterWears', 'wearsSinceWash', 'lastWorn', 'photoUrl'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.colorName is string && d.colorName.size() > 0 && d.colorName.size() <= 60
        && d.category in ['top', 'bottom', 'shoes']
        && d.formality in ['casual', 'smartCasual', 'formal']
        && d.occasionIds is list && d.occasionIds.size() > 0 && d.occasionIds.size() <= 50
        && d.tracksLaundry is bool
        && d.washAfterWears is int && d.washAfterWears >= 1 && d.washAfterWears <= 3
        && d.wearsSinceWash is int && d.wearsSinceWash >= 0
        && (d.lastWorn == null || d.lastWorn is string)
        && (d.photoUrl == null || d.photoUrl is string);
    }
    match /users/{uid}/clothes/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validClothing();
    }
    match /users/{uid}/occasions/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'isDefault'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.isDefault == false;
    }
    function validOutfit(day) {
      let d = request.resource.data;
      return d.keys().hasAll(['date','topId','bottomId','shoesId','occasionId','reason','worn'])
        && d.keys().hasOnly(['date','topId','bottomId','shoesId','occasionId','reason','worn'])
        && d.date is string && d.date == day && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validId(d.topId) && validId(d.bottomId) && validId(d.shoesId) && validId(d.occasionId)
        && d.topId != d.bottomId && d.topId != d.shoesId && d.bottomId != d.shoesId
        && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 500
        && !d.reason.matches('.*[\\r\\n].*') && d.worn is bool;
    }
    function validId(id) {
      return id is string && id.size() > 0 && id.size() <= 1500
        && id != '.' && id != '..' && !id.matches('.*/.*');
    }
    match /users/{uid}/outfits/{day} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validOutfit(day);
      allow update: if owner(uid) && validOutfit(day)
        && (resource.data.worn == false || request.resource.data == resource.data);
      allow delete: if owner(uid) && resource.data.worn == false;
    }
  }
}
